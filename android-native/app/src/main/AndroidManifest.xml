<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 通知权限（推送） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- OAuth 回环登录期间的前台服务：保持进程存活直到回调到达 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".YouhuiApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Youhui">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OAuth 回环登录窗口的前台服务（dataSync 类型；targetSdk 35 要求显式声明类型与权限） -->
        <service
            android:name=".ui.auth.OAuthLoopbackService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 新邮件 FCM 唤醒：只收通用信号，内容从用户自己的服务器拉取 -->
        <service
            android:name=".push.PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 附件分享：仅授权 cache 目录下的 downloads 子路径 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 后续阶段预留：OAuth 回环私有 scheme（设计文档 A3.4 / A3.6）
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="com.youhui.mail" android:host="oauth" />
        </intent-filter>
        -->
    </application>
</manifest>
